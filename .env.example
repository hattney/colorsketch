# ColorSketch — build-time configuration.
# Copy to `.env.local` for local work, or set these in Vercel > Project > Settings > Environment Variables.
# Everything here ships in the client bundle, so NEVER put a secret in a VITE_ variable.

# Checkout behaviour. See src/utils/checkout.ts.
#   mock     — walk the whole funnel, take no money, ask for no card. Staging / review links.
#   disabled — show the price, explain checkout is not open, unlock nothing. (default for
#              production builds when this is unset)
#   live     — Phase 2 only. Requires /api/checkout + the Lemon Squeezy webhook.
# A dev server defaults to `mock`; a production build defaults to `disabled`.
VITE_CHECKOUT_MODE=mock

# --- AI retouch (§32) -------------------------------------------------------
# Server-side only. NOT a VITE_ variable, so it never reaches the browser bundle.
# Without it, /api/ai-preview returns 503 and the editor falls back to the local tracer
# while clearly labelling the result as "not AI output".
GEMINI_API_KEY=

# Image-editing model id. Verify against Google's current model list before launch —
# image model names change. Defaults to gemini-2.5-flash-image when unset.
AI_MODEL_ID=

# --- Paid infrastructure (C단계 / PHASE2_GUIDE.md) --------------------------
# All server-side only. Every one of these degrades gracefully when unset: the AI preview
# keeps working without a cache or rate limit, checkout stays closed, etc. Wire them up as
# SETUP_CHECKLIST.md walks through it.

# Upstash Redis — order state, rate limiting, preview cache index.
# Vercel Marketplace > Upstash fills both in automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — watermark-free originals and delivered HD files.
# `vercel blob` / Marketplace > Blob fills this in automatically.
BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile — bot check before an AI preview is generated.
# Site key IS public (it renders in the page), so it is the one VITE_ variable here.
# Without the secret, /api/ai-preview skips the check; without the site key, no widget renders.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lemon Squeezy (MoR) — single $2.99 payment for both HD styles.
# All four are required before checkout works. Start in the store's Test mode.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Resend — transactional email (optional; every send is best-effort).
#   buyer "your pages are ready" mail  → needs RESEND_FROM on a domain verified in Resend
#   admin alert when an order fails    → goes to ADMIN_EMAIL
# Without a verified domain, Resend only delivers to the account owner, which still covers
# the admin alert during testing.
RESEND_API_KEY=
RESEND_FROM=ColorSketch <noreply@yourdomain.com>
ADMIN_EMAIL=
